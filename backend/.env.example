# === App Environment ===
APP_ENV=development
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# === Provider Selection ===
# ASR Options: mock, deepgram, whisper
DEFAULT_ASR_PROVIDER=mock

# TTS Options: mock, elevenlabs, openai
DEFAULT_TTS_PROVIDER=mock

# LLM Options: nvidia, openai, mock
DEFAULT_LLM_PROVIDER=nvidia

# === NVIDIA AI API ===
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# === OpenAI API (Fallback ASR/TTS/LLM) ===
OPENAI_API_KEY=your_openai_api_key_here

# === Deepgram API (ASR) ===
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# === ElevenLabs API (TTS) ===
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# === Supabase / PostgreSQL ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# === Langfuse Observability ===
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
